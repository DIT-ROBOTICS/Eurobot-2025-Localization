# Environment variables for Docker Compose

# General settings
COMPOSE_PROJECT_NAME=localization
COMPOSE_FILE=docker-compose.yaml:OdomComm/docker/compose.yml

# Release version
# COMPOSE_PROFILES = communication, localization_main

# debug version
COMPOSE_PROFILES = localization_devel

# environment variables
## for compose up
ROS2_LAUNCH_FILE = /home/user/localization-ws/src/localization-devel-ws/ekf/launch/blue.launch
# ROS2_LAUNCH_FILE = /home/user/localization-ws/src/localization-devel-ws/ekf/launch/yellow.launch
ROS_DOMAIN_ID = 3
# for compose build
PACKAGE_SELECT = obstacle_detector
BRANCH_SELECT = devel